# ─────────────────────────────────────────────────────────────────────────────
#  PRISM — environment
#  Copy to .env.local and fill in what you need. Everything except the secret is
#  optional: Prism runs fully local-first with a file store and no cloud.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# Used to derive the AES-256-GCM key that encrypts provider API keys at rest.
# Generate one with:  openssl rand -base64 32
PRISM_SECRET=
# Public origin, used in share links and OpenRouter attribution.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Directory for the JSON store + generated media when not using Postgres.
PRISM_DATA_DIR=

# ── Database (optional) ──────────────────────────────────────────────────────
# With DATABASE_URL set, Prism stores each user (providers, settings, usage,
# runs, projects) in one JSONB row in `prism_users`. Without it, Prism writes
# .data/prism-store.json. Supabase: use the pooled connection string.
DATABASE_URL=

# ── Stock imagery (optional, server-side only) ───────────────────────────────
# Without these, `search_stock` reports that it is unconfigured and the agent
# falls back to generated imagery / geometry. No fake results are ever returned.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── Auth (optional) ──────────────────────────────────────────────────────────
# Prism ships with an anonymous cookie session (works instantly, local-first).
# Add Clerk or Supabase Auth for real accounts — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Object storage (optional) ────────────────────────────────────────────────
# Generated media is written to .data/generated and served from /api/assets/…
# Point these at S3/R2 to survive serverless cold starts.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=


# ── Built-in "Prism AI Cloud" (optional but recommended) ─────────────────────
# Prism can ship with its own managed, OpenAI-compatible inference so the agent
# works with zero setup. These keys are used ONLY server-side; they are never
# sent to the browser and never appear in /api/ai/providers responses.
# Opencode: https://opencode.ai/inference/openai/v1  ·  default model kimi-k2.6
PRISM_AI_API_KEY=
PRISM_AI_BASE_URL=https://opencode.ai/inference/openai/v1
PRISM_AI_MODEL=kimi-k2.6
# Secondary managed provider (OpenRouter). Leave blank to disable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional alias accepted by the provider core:
OPENCODE_API_KEY=

# ── Limits ───────────────────────────────────────────────────────────────────
# Requests per minute per user for /api/ai/chat (default 30).
PRISM_CHAT_RATE_LIMIT=30
