# ============================================================
# PRISM — environment configuration
# Copy to `.env.local` for local dev. Everything here is OPTIONAL
# for a local run (you can paste keys in Settings → AI Providers),
# but PRISM_ENCRYPTION_KEY is REQUIRED in production.
# ============================================================

# --- Key encryption (AES-256-GCM) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it, a dev secret is written to .prism-secret (gitignored).
PRISM_ENCRYPTION_KEY=

# --- Provider keys via env (fallback; BYO keys in Settings take precedence) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Production storage (when swapping the local file store for Postgres) ---
DATABASE_URL=
# Supabase (projects, auth, storage) — see supabase/migrations/0001_prism.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clerk (alternative auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# S3-compatible asset storage (R2/S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Optional media providers (agent sub-tools, plug in later) ---
ELEVENLABS_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
